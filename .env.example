# Copy to .env and fill in local values. Never commit the real .env file.
# See docs/DECISIONS_AND_ASSUMPTIONS.md D-10 for the local port map.
#
# Works unchanged for either dev mode (see README "Getting Started"):
#   - Docker infra mode: `docker compose up -d` and these defaults just work —
#     Postgres/Redis/MinIO/ClamAV are exposed on the host ports below.
#   - Native/local mode (no Docker): install Postgres/Redis/MinIO yourself and
#     edit the values below (most likely just POSTGRES_PORT/DATABASE_URL — see
#     the note there) to match wherever you installed them.

# ---------- General ----------
# NODE_ENV is intentionally not set here: each tool (Next.js, NestJS, Jest)
# manages it appropriately for its own command (dev/build/test). Setting it in
# a shared, dotenv-loaded file breaks `next build`'s internal prod/dev
# consistency — see docs/TECHNICAL_DEBT_REGISTER.md TD-010 for the incident.

# ---------- Postgres (required to start apps/api — Prisma connects at boot) ----------
POSTGRES_USER=examora
POSTGRES_PASSWORD=examora_local_password
POSTGRES_DB=examora
# 5433, not Postgres's standard 5432 — deliberate, so docker-compose's Postgres
# can run alongside a native Postgres install on the same machine without a
# port clash. Running Postgres natively instead of via Docker? Either point
# your native instance at port 5433 too, or change POSTGRES_PORT/DATABASE_URL
# below to your native instance's actual port/credentials (5432 is the
# standard default) and database/user name.
POSTGRES_PORT=5433
# Full connection string consumed by Prisma (host port, since apps run on the host)
DATABASE_URL=postgresql://examora:examora_local_password@localhost:5433/examora?schema=public

# ---------- LOCAL DEVELOPMENT ONLY — demo account password ----------
# `pnpm db:migrate` seeds three demo accounts (admin@examora.test,
# mentor@examora.test, student@examora.test — database/prisma/seed.ts) plus
# realistic interconnected demo content (courses, quizzes, assignments,
# mentoring, community, notifications, CMS, commerce) so a fresh clone —
# Docker or native Postgres, identically — has a fully usable demo
# environment immediately. Never seeded when NODE_ENV=production (see
# README "Local development demo accounts"). This is a placeholder value,
# not a secret; override it if you want a different local password.
DEV_SEED_PASSWORD=a-strong-password-123

# ---------- Redis (not required to boot apps/api — connects lazily — but
# required for BullMQ background jobs, rate limiting, and sessions/cache to
# actually work; see docs/release/v1.0.0/DEPLOYMENT_CHECKLIST.md §7) ----------
REDIS_PASSWORD=examora_local_password
REDIS_PORT=6379
REDIS_URL=redis://:examora_local_password@localhost:6379

# ---------- MinIO / S3-compatible object storage (only required for
# upload-dependent features — assignments, CMS assets, community attachments;
# apps/api boots fine without it) ----------
MINIO_ROOT_USER=examora_minio
MINIO_ROOT_PASSWORD=examora_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=examora-uploads
# S3-compatible client config consumed by apps/api — point this at any real S3
# or S3-compatible endpoint (e.g. AWS S3 itself) instead of MinIO if preferred
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=examora_minio
S3_SECRET_ACCESS_KEY=examora_local_password
S3_BUCKET=examora-uploads
S3_FORCE_PATH_STYLE=true

# ---------- ClamAV (malware scanning, ADR-0005/ADR-0015) — fully optional in
# dev. Lazily initialized; unreachable/absent just means uploaded files never
# clear malware scanning (see ClamAvScannerService for details) ----------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------- apps/api ----------
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Used to build links in verification/reset emails (Sprint 1 console mailer stub)
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# JWT / auth (ADR-0006) — generate real secrets before any non-local environment
JWT_ACCESS_SECRET=replace_with_a_long_random_value_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=examora_refresh_token

# ---------- apps/web ----------
NEXT_PUBLIC_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# Full origin apps/admin is reachable at from the browser — used only for the
# Admin Executive Dashboard's cross-app quick-action links. Must be a real
# origin (e.g. https://admin.example.com) in production; a browser can never
# reach the server's own localhost.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3002
# Same value as VAPID_PUBLIC_KEY below (ADR-0019 §6) — safe to expose to the browser,
# it's the public half of the keypair. Web Push opt-in is hidden when unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------- apps/admin ----------
NEXT_PUBLIC_ADMIN_PORT=3002
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# ---------- Vendor integrations (ADR-0005) — optional/unused in Sprint 0 ----------
# Email (AWS SES default)
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
# SMS / WhatsApp (Twilio default, MSG91 fallback candidate)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_BUSINESS_TOKEN=
# Web Push (VAPID, Sprint 9 / ADR-0019 §6) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Video (Cloudflare Stream) — NOT IMPLEMENTED. No backend service, adapter, or
# `configured` flag exists for these anywhere in apps/api (unlike SES/Twilio/
# VAPID/Razorpay, which all have real log-fallback wiring when unconfigured).
# Setting these has no effect. VIDEO-type lessons currently just store an
# arbitrary contentUrl string. Left here only as a placeholder for future work.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Payments (Razorpay — confirmed requirement, not a default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# OAuth (Sprint 1 wires the code path; leave blank locally — GoogleConfiguredGuard
# returns 503 on /auth/google rather than crashing the app when unset)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ---------- Observability (stubs — wired per TD-003) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
