# Copy to .env and fill in local values. Never commit the real .env file.
# See docs/DECISIONS_AND_ASSUMPTIONS.md D-10 for the local port map.

# ---------- General ----------
# NODE_ENV is intentionally not set here: each tool (Next.js, NestJS, Jest)
# manages it appropriately for its own command (dev/build/test). Setting it in
# a shared, dotenv-loaded file breaks `next build`'s internal prod/dev
# consistency — see docs/TECHNICAL_DEBT_REGISTER.md TD-010 for the incident.

# ---------- Postgres (docker-compose + Prisma) ----------
POSTGRES_USER=examora
POSTGRES_PASSWORD=examora_local_password
POSTGRES_DB=examora
POSTGRES_PORT=5433
# Full connection string consumed by Prisma (host port, since apps run on the host in Sprint 0)
DATABASE_URL=postgresql://examora:examora_local_password@localhost:5433/examora?schema=public

# ---------- Redis ----------
REDIS_PASSWORD=examora_local_password
REDIS_PORT=6379
REDIS_URL=redis://:examora_local_password@localhost:6379

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ROOT_USER=examora_minio
MINIO_ROOT_PASSWORD=examora_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=examora-uploads
# S3-compatible client config consumed by apps/api
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=examora_minio
S3_SECRET_ACCESS_KEY=examora_local_password
S3_BUCKET=examora-uploads
S3_FORCE_PATH_STYLE=true

# ---------- ClamAV (malware scanning, ADR-0005/ADR-0015) ----------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------- apps/api ----------
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Used to build links in verification/reset emails (Sprint 1 console mailer stub)
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# JWT / auth (ADR-0006) — generate real secrets before any non-local environment
JWT_ACCESS_SECRET=replace_with_a_long_random_value_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=examora_refresh_token

# ---------- apps/web ----------
NEXT_PUBLIC_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# ---------- apps/admin ----------
NEXT_PUBLIC_ADMIN_PORT=3002
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# ---------- Vendor integrations (ADR-0005) — optional/unused in Sprint 0 ----------
# Email (AWS SES default)
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SMS / WhatsApp (Twilio default, MSG91 fallback candidate)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_BUSINESS_TOKEN=
# Video (Cloudflare Stream default)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Payments (Razorpay — confirmed requirement, not a default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# OAuth (Sprint 1 wires the code path; leave blank locally — GoogleConfiguredGuard
# returns 503 on /auth/google rather than crashing the app when unset)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ---------- Observability (stubs — wired per TD-003) ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
