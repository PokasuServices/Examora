// Examora Platform — Prisma schema
// Sprint 0 scope: Identity & Access only (users, roles, permissions, oauth, sessions, audit).
// Sprint 1 adds: email verification / password reset tokens, consent audit trail, and
// identity-level profile fields (phone, DOB, guardian contact). Course/exam-related profile
// fields (target exam, exam year) stay out of scope until the Learning module exists.
// Business-domain models (Learning, Assessment, Creative, Mentoring, Commerce, Notifications)
// are added incrementally per docs/roadmap/SPRINT_BACKLOG.md, sourced from DB-05 / DB-16 / DB-34.
//
// Naming: snake_case columns/tables via @map/@@map (DB-16 §2). UUID surrogate keys (DB-34 §2).
// "sessions" (DB-05 §3) is implemented as `refresh_tokens` — see ADR-0006 for the auth strategy
// that hashed, revocable refresh tokens represent a user session.
// Raw-SQL exceptions (views/materialized views/procedures) are governed by ADR-0007 and do not
// appear in this file — they live in hand-written migration SQL.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("user_status")
}

enum RoleName {
  STUDENT
  MENTOR
  REVIEWER
  ADMINISTRATOR
  GUARDIAN

  @@map("role_name")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_token_type")
}

/// Consent purposes captured independently of the one-time ToS acceptance on
/// User (below) — an append-only trail per DATA-27 governance controls and
/// SRS-02 Table 5 ("Consent/Enquiry: purpose, version, shared fields, status").
enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
  GUARDIAN_COMMUNICATION

  @@map("consent_type")
}

/// Platform user. Identity & Access core entity (DB-05 §3, SRS-02 Table 5).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  // Identity-level profile fields only (FR-PROFILE-01). Course-domain fields
  // (target exam, exam year) are added when the Learning module exists.
  phone           String?
  dateOfBirth     DateTime?  @map("date_of_birth") @db.Date
  guardianName    String?    @map("guardian_name")
  guardianEmail   String?    @map("guardian_email")
  // Consent capture per FR-PROFILE-01 acceptance criterion: version, channel, timestamp, actor.
  // Kept as a fast "latest ToS acceptance" cache set at registration; the full
  // auditable history (including later consent changes) lives in ConsentRecord.
  consentVersion  String?    @map("consent_version")
  consentChannel  String?    @map("consent_channel")
  consentedAt     DateTime?  @map("consented_at")
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles              UserRole[]
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  consentRecords     ConsentRecord[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  @@index([status])
  @@map("users")
}

/// RBAC role. Seeded from DESIGN-03 Table 1 (Student, Mentor, Reviewer, Administrator, Guardian).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission catalog entry. Full matrix populated in Sprint 1 per DESIGN-03 §3.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// FR-AUTH-01: configurable OAuth providers.
model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

/// Hashed, revocable refresh token — represents a user session (ADR-0006).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Hashed, single-use token backing email verification and password reset
/// (ADR-0009). Hashed for the same reason as RefreshToken — see ADR-0006.
model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Append-only consent trail (DATA-27 governance controls; SRS-02 BR-06 for
/// GUARDIAN_COMMUNICATION specifically). Every consent action is a new row —
/// never updated — so history is always reconstructable.
model ConsentRecord {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  channel   String
  granted   Boolean
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consent_records")
}

/// Append-only audit log. Never deleted, never updated after insert (MDG-00 §14, SEC-13 §7).
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  ipAddress     String?  @map("ip_address")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
