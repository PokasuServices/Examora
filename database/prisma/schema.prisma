// Examora Platform — Prisma schema
// Sprint 0 scope: Identity & Access only (users, roles, permissions, oauth, sessions, audit).
// Sprint 1 adds: email verification / password reset tokens, consent audit trail, and
// identity-level profile fields (phone, DOB, guardian contact). Course/exam-related profile
// fields (target exam, exam year) stay out of scope until the Learning module exists.
// Sprint 2 adds: the content hierarchy — Category > Course > Subject > Topic > Module > Lesson
// (CMS-29 §2, DB-16/DB-34). Content nodes carry a 3-state ContentStatus (ADR-0012). Enrollment,
// progress, quizzes, assignments, versioning/revision-history are NOT in Sprint 2.
// Sprint 3 adds: the learning engine — LessonProgress (per-student, per-lesson view/completion,
// FR-PROGRESS-01, ADR-0013). No enrollment gate yet; quizzes/assignments still out of scope.
// Sprint 4 adds: the assessment/quiz engine — Question/QuestionOption bank, Quiz/QuizSection/
// QuizQuestion authoring, and QuizAttempt/QuizAttemptAnswer with frozen-at-start scoring
// (ASSESS-09, ADR-0014). Creative assignments, mentoring, community, notifications, payments,
// analytics, AI and CMS enhancements are NOT in Sprint 4 scope.
// Business-domain models (Creative, Mentoring, Commerce, Notifications) are added
// incrementally per docs/roadmap/SPRINT_BACKLOG.md, sourced from DB-05 / DB-16 / DB-34.
//
// Naming: snake_case columns/tables via @map/@@map (DB-16 §2). UUID surrogate keys (DB-34 §2).
// "sessions" (DB-05 §3) is implemented as `refresh_tokens` — see ADR-0006 for the auth strategy
// that hashed, revocable refresh tokens represent a user session.
// Raw-SQL exceptions (views/materialized views/procedures) are governed by ADR-0007 and do not
// appear in this file — they live in hand-written migration SQL.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("user_status")
}

enum RoleName {
  STUDENT
  MENTOR
  REVIEWER
  ADMINISTRATOR
  GUARDIAN

  @@map("role_name")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_token_type")
}

/// Consent purposes captured independently of the one-time ToS acceptance on
/// User (below) — an append-only trail per DATA-27 governance controls and
/// SRS-02 Table 5 ("Consent/Enquiry: purpose, version, shared fields, status").
enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
  GUARDIAN_COMMUNICATION

  @@map("consent_type")
}

/// Publish lifecycle for content nodes (Sprint 2, ADR-0012). The fuller
/// CMS-29 §4 workflow (IN_REVIEW / APPROVED / RESTORED) is deferred.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

/// Lesson payload kind (SRS-02 FR-CONTENT-02). Sprint 2 stores a reference/body
/// only — signed media upload and rendering land in a later sprint.
enum LessonContentType {
  TEXT
  VIDEO
  PDF
  IMAGE
  ARTICLE

  @@map("lesson_content_type")
}

/// Server-gradable question formats only (ADR-0014) — no free-text/descriptive
/// types, since automatic evaluation is a hard Sprint 4 requirement.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE

  @@map("question_type")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD

  @@map("difficulty_level")
}

/// A submitted/auto-submitted attempt is permanently closed (ADR-0014) — the
/// `IN_PROGRESS -> {SUBMITTED, AUTO_SUBMITTED}` transition happens exactly once.
enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED

  @@map("quiz_attempt_status")
}

/// Each resubmission is a new row (ADR-0015, mirrors QuizAttempt versioning).
/// DRAFT: student editing. SUBMITTED: locked, awaiting a reviewer. UNDER_REVIEW:
/// a reviewer has an unpublished AssignmentReview in progress. REVISION_REQUESTED
/// / APPROVED: terminal — a published review's decision.
enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED

  @@map("assignment_submission_status")
}

/// A reviewer can save rubric scores before publishing (ADR-0015) — only a
/// PUBLISHED review is visible to the student and flips the submission status.
enum ReviewStatus {
  DRAFT
  PUBLISHED

  @@map("review_status")
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED

  @@map("review_decision")
}

/// A file starts PENDING and is only ever downloadable once CLEAN (ADR-0015).
/// INFECTED files are deleted from storage immediately; FAILED means the scan
/// itself errored (treated the same as PENDING for access purposes — retry).
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED

  @@map("file_scan_status")
}

enum MentorTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("mentor_task_status")
}

/// A thread is either a general discussion or a doubt-resolution question —
/// the same model serves both (ADR-0017) so "answer" behavior (accepted
/// answer, solved/unsolved) is just Reply/Thread fields that are unused on
/// DISCUSSION-type threads.
enum ThreadType {
  DISCUSSION
  QUESTION

  @@map("thread_type")
}

/// The linear part of thread status (ADR-0017) — pin/lock/hide are
/// independent booleans, not part of this enum, since a thread can be
/// pinned AND locked AND closed simultaneously.
enum ThreadStatus {
  OPEN
  CLOSED

  @@map("thread_status")
}

/// Shared by CommunityLike and CommunityReport — a like/report can target
/// either a thread or a reply (ADR-0017).
enum CommunityTargetType {
  THREAD
  REPLY

  @@map("community_target_type")
}

enum CommunityReportStatus {
  PENDING
  REVIEWED
  DISMISSED

  @@map("community_report_status")
}

/// A single current-access-state row per (user, course) — ADR-0018. Renewed
/// by updating the same row, not by inserting a new one (Order already
/// provides the historical/audit trail).
enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("enrollment_status")
}

enum EnrollmentSource {
  FREE
  PURCHASE
  ADMIN_GRANT

  @@map("enrollment_source")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("order_status")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED

  @@map("coupon_discount_type")
}

/// Gateway-agnostic (ADR-0018) — Razorpay is the only concrete adapter today
/// (ADR-0005), but Payment.gateway is not hardcoded to it.
enum PaymentGateway {
  RAZORPAY

  @@map("payment_gateway")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED

  @@map("payment_status")
}

/// A request/review state machine (foundation only, ADR-0018) — actual
/// gateway-side refund settlement is deferred (TD-037).
enum RefundStatus {
  REQUESTED
  APPROVED
  DENIED
  PROCESSED

  @@map("refund_status")
}

/// COMM-MERGED §2 (ADR-0004/0019). MOBILE_PUSH is an adapter-interface-only
/// channel — no live delivery integration exists (native app is a PRD-01 §9
/// non-goal).
enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  WEB_PUSH
  IN_APP
  MOBILE_PUSH

  @@map("notification_channel")
}

/// The reconciled delivery-state taxonomy — COMM-MERGED §7 (ADR-0004),
/// unmodified. FAILED/RETRIED/SUPPRESSED are side/terminal states reachable
/// from QUEUED at any point; SUPPRESSED (not sent, due to opt-out/consent
/// gate/rate limit) is required for DATA-27 consent-compliance reporting.
enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  ACKNOWLEDGED
  FAILED
  RETRIED
  SUPPRESSED

  @@map("notification_delivery_status")
}

enum NotificationDigestMode {
  INSTANT
  DAILY
  WEEKLY

  @@map("notification_digest_mode")
}

/// Analytics & Reporting (Sprint 10, ADR-0020 §5) — one entry per report the
/// Report Builder can compute; kept as an enum (not a free-form string) so
/// ScheduledReport.reportType stays validatable and each report's query
/// implementation is a switch-case, not string matching.
enum ReportType {
  STUDENT_PROGRESS
  COURSE_COMPLETION
  QUIZ_PERFORMANCE
  ASSIGNMENT_PERFORMANCE
  ENROLLMENT
  REVENUE
  COURSE_PERFORMANCE
  MENTOR_PERFORMANCE
  COMMUNITY_ACTIVITY
  NOTIFICATION_DELIVERY

  @@map("report_type")
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY

  @@map("report_cadence")
}

enum ReportFormat {
  CSV
  PDF

  @@map("report_format")
}

/// Recommendation types the feature-flag toggle covers (Sprint 11, ADR-0021 §4).
enum RecommendationType {
  COURSE
  SIMILAR_COURSES
  LEARNING_PATH
  CONTINUE_LEARNING
  QUIZ
  ASSIGNMENT
  COMMUNITY_DISCUSSION

  @@map("recommendation_type")
}

/// CMS content-type discriminator for the shared CmsContentVersion/
/// CmsAssetUsage tables (Sprint 12, ADR-0022 §3/§5).
enum CmsContentType {
  PAGE
  FAQ
  ANNOUNCEMENT
  BANNER

  @@map("cms_content_type")
}

enum CmsPageType {
  LANDING
  STATIC

  @@map("cms_page_type")
}

/// Draft -> Review -> Approval -> Publish -> Archive (Sprint 12, ADR-0022 §1).
/// Deliberately separate from the curriculum hierarchy's ContentStatus
/// (Sprint 2) — see ADR-0022 §1.
enum CmsWorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED

  @@map("cms_workflow_status")
}

/// Platform user. Identity & Access core entity (DB-05 §3, SRS-02 Table 5).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  // Identity-level profile fields only (FR-PROFILE-01). Course-domain fields
  // (target exam, exam year) are added when the Learning module exists.
  phone           String?
  dateOfBirth     DateTime?  @map("date_of_birth") @db.Date
  guardianName    String?    @map("guardian_name")
  guardianEmail   String?    @map("guardian_email")
  // Consent capture per FR-PROFILE-01 acceptance criterion: version, channel, timestamp, actor.
  // Kept as a fast "latest ToS acceptance" cache set at registration; the full
  // auditable history (including later consent changes) lives in ConsentRecord.
  consentVersion  String?    @map("consent_version")
  consentChannel  String?    @map("consent_channel")
  consentedAt     DateTime?  @map("consented_at")
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles                 UserRole[]
  oauthAccounts         OAuthAccount[]
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  consentRecords        ConsentRecord[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[] @relation("SubmissionsByStudent")
  reviewedSubmissions   AssignmentSubmission[] @relation("SubmissionsByReviewer")
  assignmentReviews     AssignmentReview[]
  assignmentComments    AssignmentComment[]
  auditLogs             AuditLog[]             @relation("AuditActor")

  mentorProfile              MentorProfile?
  mentorAssignmentsAsStudent MentorAssignment[] @relation("MentorAssignmentsByStudent")
  mentorAssignmentsAsMentor  MentorAssignment[] @relation("MentorAssignmentsByMentor")
  mentorAssignmentsMade      MentorAssignment[] @relation("MentorAssignmentsByAdmin")
  mentorNotesAsStudent       MentorNote[]       @relation("MentorNotesByStudent")
  mentorNotesAsMentor        MentorNote[]       @relation("MentorNotesByMentor")
  mentorTasksAsStudent       MentorTask[]       @relation("MentorTasksByStudent")
  mentorTasksAsMentor        MentorTask[]       @relation("MentorTasksByMentor")
  mentorFeedbackAsStudent    MentorFeedback[]   @relation("MentorFeedbackByStudent")
  mentorFeedbackAsMentor     MentorFeedback[]   @relation("MentorFeedbackByMentor")
  mentorMeetingsAsStudent    MentorMeeting[]    @relation("MentorMeetingsByStudent")
  mentorMeetingsAsMentor     MentorMeeting[]    @relation("MentorMeetingsByMentor")

  communityProfile     CommunityProfile?
  forumCategoriesMade  ForumCategory[]
  forumBoardsMade      ForumBoard[]
  threads              Thread[]              @relation("ThreadsByAuthor")
  moderatedThreads     Thread[]              @relation("ThreadsByModerator")
  replies              Reply[]               @relation("RepliesByAuthor")
  moderatedReplies     Reply[]               @relation("RepliesByModerator")
  communityLikes       CommunityLike[]
  communityBookmarks   CommunityBookmark[]
  threadFollows        ThreadFollow[]
  communityReports     CommunityReport[]     @relation("ReportsByReporter")
  reviewedReports      CommunityReport[]     @relation("ReportsByReviewer")
  reputationEvents     ReputationEvent[]
  communityAttachments CommunityAttachment[]

  enrollments      Enrollment[]
  orders           Order[]
  couponsCreated   Coupon[]
  refundsRequested Refund[]     @relation("RefundsByRequester")
  refundsReviewed  Refund[]     @relation("RefundsByReviewer")

  notifications          Notification[]
  notificationPreference NotificationPreference?
  webPushSubscriptions   WebPushSubscription[]

  scheduledReports ScheduledReport[]

  recommendationFeatureFlagsUpdated RecommendationFeatureFlag[]

  cmsAssetsUploaded    CmsAsset[]
  cmsPagesCreated      CmsPage[]           @relation("CmsPageCreatedBy")
  cmsPagesUpdated      CmsPage[]           @relation("CmsPageUpdatedBy")
  cmsFaqItemsCreated   CmsFaqItem[]        @relation("CmsFaqItemCreatedBy")
  cmsFaqItemsUpdated   CmsFaqItem[]        @relation("CmsFaqItemUpdatedBy")
  cmsAnnouncementsCreated CmsAnnouncement[] @relation("CmsAnnouncementCreatedBy")
  cmsAnnouncementsUpdated CmsAnnouncement[] @relation("CmsAnnouncementUpdatedBy")
  cmsBannersCreated    CmsBanner[]         @relation("CmsBannerCreatedBy")
  cmsBannersUpdated    CmsBanner[]         @relation("CmsBannerUpdatedBy")
  cmsContentVersionsCreated CmsContentVersion[]

  @@index([status])
  @@map("users")
}

/// RBAC role. Seeded from DESIGN-03 Table 1 (Student, Mentor, Reviewer, Administrator, Guardian).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission catalog entry. Full matrix populated in Sprint 1 per DESIGN-03 §3.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// FR-AUTH-01: configurable OAuth providers.
model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

/// Hashed, revocable refresh token — represents a user session (ADR-0006).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Hashed, single-use token backing email verification and password reset
/// (ADR-0009). Hashed for the same reason as RefreshToken — see ADR-0006.
model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// Append-only consent trail (DATA-27 governance controls; SRS-02 BR-06 for
/// GUARDIAN_COMMUNICATION specifically). Every consent action is a new row —
/// never updated — so history is always reconstructable.
model ConsentRecord {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  channel   String
  granted   Boolean
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consent_records")
}

/// Append-only audit log. Never deleted, never updated after insert (MDG-00 §14, SEC-13 §7).
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  ipAddress     String?  @map("ip_address")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Content hierarchy (Sprint 2): Category > Course > Subject > Topic > Module > Lesson.
// Common columns follow DB-05 §5 / DB-16 §4 conventions: position for ordering
// (FR-CONTENT-01 "reorder"), `version` for optimistic locking (MDG-00 §10),
// createdById for content ownership (CMS-29 §11), and soft delete via deletedAt.
// The authoritative "who changed what" trail is AuditLog, not per-row columns.
// ---------------------------------------------------------------------------

/// Top-level taxonomy grouping courses by discipline/exam family (e.g. Design,
/// Fashion). Pure taxonomy — not learning content — so it carries isActive
/// rather than the ContentStatus publish lifecycle.
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  position    Int       @default(0)
  createdById String?   @map("created_by_id") @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  courses Course[]

  @@index([isActive])
  @@map("categories")
}

model Course {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String?       @map("category_id") @db.Uuid
  title         String
  slug          String        @unique
  description   String?
  examType      String?       @map("exam_type")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  position      Int           @default(0)
  createdById   String?       @map("created_by_id") @db.Uuid
  version       Int           @default(1)
  // Sprint 8 (ADR-0018): a null priceAmount means the course is free — the
  // same behavior every course has had since Sprint 3. No separate pricing/
  // plan model this sprint (TD-036).
  priceAmount   Decimal?      @map("price_amount") @db.Decimal(10, 2)
  priceCurrency String        @default("INR") @map("price_currency")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  lessonProgress LessonProgress[]
  relatedThreads Thread[]         @relation("ThreadsByCourse")
  enrollments    Enrollment[]
  orders         Order[]

  @@index([categoryId])
  @@index([status])
  @@index([examType])
  @@map("courses")
}

model Subject {
  id          String        @id @default(uuid()) @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  slug        String
  description String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  createdById String?       @map("created_by_id") @db.Uuid
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics Topic[]

  // Sprint 4: questions and quizzes optionally classify under a subject
  // (ADR-0014 — reuses the curriculum taxonomy instead of a parallel one).
  questions   Question[]
  quizzes     Quiz[]
  // Sprint 5: assignments do the same (ADR-0015).
  assignments Assignment[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([status])
  @@map("subjects")
}

model Topic {
  id          String        @id @default(uuid()) @db.Uuid
  subjectId   String        @map("subject_id") @db.Uuid
  title       String
  slug        String
  description String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  createdById String?       @map("created_by_id") @db.Uuid
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  modules Module[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([status])
  @@map("topics")
}

model Module {
  id          String        @id @default(uuid()) @db.Uuid
  topicId     String        @map("topic_id") @db.Uuid
  title       String
  slug        String
  description String?
  // Nullable classification label (DB-16 lists `modules.type`); e.g. LEARNING,
  // PRACTICE, ESSENTIALS. Kept free-form and optional in Sprint 2.
  type        String?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  createdById String?       @map("created_by_id") @db.Uuid
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  topic   Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@index([status])
  @@map("modules")
}

model Lesson {
  id              String            @id @default(uuid()) @db.Uuid
  moduleId        String            @map("module_id") @db.Uuid
  title           String
  slug            String
  contentType     LessonContentType @default(TEXT) @map("content_type")
  // Rich-text/markdown body for TEXT/ARTICLE lessons; contentUrl references
  // external/hosted media for VIDEO/PDF/IMAGE (real signed uploads: later sprint).
  body            String?
  contentUrl      String?           @map("content_url")
  durationMinutes Int?              @map("duration_minutes")
  status          ContentStatus     @default(DRAFT)
  position        Int               @default(0)
  createdById     String?           @map("created_by_id") @db.Uuid
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress       LessonProgress[]
  relatedThreads Thread[]         @relation("ThreadsByLesson")

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@index([status])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Learning engine (Sprint 3): per-student, per-lesson progress. Sprint 3 has no
// enrollment/entitlement gate (ADR-0013) — any authenticated student may learn
// any fully-published course, and progress is tracked as they view/complete
// lessons. `courseId` is denormalized for fast course-level aggregation.
// ---------------------------------------------------------------------------
model LessonProgress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  lessonId      String    @map("lesson_id") @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  firstViewedAt DateTime  @default(now()) @map("first_viewed_at")
  lastViewedAt  DateTime  @default(now()) @map("last_viewed_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@index([userId, lastViewedAt])
  @@index([courseId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// Assessment & Quiz Engine (Sprint 4, ASSESS-09, ADR-0014). Question bank +
// quiz authoring (DRAFT/PUBLISHED/ARCHIVED via the shared ContentStatus) and
// timed student attempts with frozen-at-start scoring. Creative/manually-
// graded question types are out of scope — every QuestionType is server-
// gradable, so scoring is fully automatic.
// ---------------------------------------------------------------------------

/// Bank question. `subjectId` reuses the Sprint 2 curriculum taxonomy instead
/// of a parallel "question category" entity (ADR-0014); `tags` is a flat
/// array rather than a normalized Tag entity for the same reason.
model Question {
  id          String          @id @default(uuid()) @db.Uuid
  subjectId   String?         @map("subject_id") @db.Uuid
  type        QuestionType
  difficulty  DifficultyLevel @default(MEDIUM)
  text        String
  explanation String?
  tags        String[]        @default([])
  status      ContentStatus   @default(DRAFT)
  position    Int             @default(0)
  createdById String?         @map("created_by_id") @db.Uuid
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  subject        Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  options        QuestionOption[]
  quizQuestions  QuizQuestion[]
  attemptAnswers QuizAttemptAnswer[]

  @@index([subjectId])
  @@index([status])
  @@index([type])
  @@index([difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

/// Quiz shell. Marking rules (passing score, negative marking, shuffle) live
/// here as the *current* configuration; each QuizAttempt freezes its own copy
/// at start (ADR-0014) so editing a quiz never retroactively changes an
/// attempt already underway or submitted.
model Quiz {
  id                     String        @id @default(uuid()) @db.Uuid
  subjectId              String?       @map("subject_id") @db.Uuid
  title                  String
  slug                   String        @unique
  description            String?
  status                 ContentStatus @default(DRAFT)
  timeLimitMinutes       Int?          @map("time_limit_minutes")
  passingScorePercent    Decimal       @default(40) @map("passing_score_percent") @db.Decimal(5, 2)
  negativeMarkingEnabled Boolean       @default(false) @map("negative_marking_enabled")
  negativeMarksPerWrong  Decimal       @default(0) @map("negative_marks_per_wrong") @db.Decimal(5, 2)
  shuffleQuestions       Boolean       @default(false) @map("shuffle_questions")
  shuffleOptions         Boolean       @default(false) @map("shuffle_options")
  position               Int           @default(0)
  publishedAt            DateTime?     @map("published_at")
  createdById            String?       @map("created_by_id") @db.Uuid
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  deletedAt              DateTime?     @map("deleted_at")

  subject        Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sections       QuizSection[]
  quizQuestions  QuizQuestion[]
  attempts       QuizAttempt[]
  relatedThreads Thread[]       @relation("ThreadsByQuiz")

  @@index([subjectId])
  @@index([status])
  @@map("quizzes")
}

model QuizSection {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @map("quiz_id") @db.Uuid
  title       String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]

  @@index([quizId])
  @@map("quiz_sections")
}

/// Question-to-quiz assignment. `marks` is set per assignment (not inherited
/// from the question) so the same question can carry different weight in
/// different quizzes.
model QuizQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  quizId     String   @map("quiz_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  sectionId  String?  @map("section_id") @db.Uuid
  marks      Decimal  @default(1) @db.Decimal(6, 2)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section  QuizSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
  @@index([sectionId])
  @@map("quiz_questions")
}

/// A student's timed attempt at a quiz. Freezes composition/marks/shuffle at
/// start; correctness is graded live at submit time and then permanently
/// fixed (ADR-0014). `version` guards the submit transition against
/// concurrent double-submission.
model QuizAttempt {
  id     String            @id @default(uuid()) @db.Uuid
  quizId String            @map("quiz_id") @db.Uuid
  userId String            @map("user_id") @db.Uuid
  status QuizAttemptStatus @default(IN_PROGRESS)

  /// {questionId, sectionId, marks}[] in frozen presentation order.
  questionSnapshot Json @map("question_snapshot")
  /// { [questionId]: optionId[] } frozen (possibly shuffled) option order.
  optionOrder      Json @map("option_order")

  passingScorePercent    Decimal @map("passing_score_percent") @db.Decimal(5, 2)
  negativeMarkingEnabled Boolean @map("negative_marking_enabled")
  negativeMarksPerWrong  Decimal @map("negative_marks_per_wrong") @db.Decimal(5, 2)
  totalMarks             Decimal @map("total_marks") @db.Decimal(8, 2)

  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  submittedAt DateTime? @map("submitted_at")

  obtainedMarks   Decimal? @map("obtained_marks") @db.Decimal(8, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  passed          Boolean?
  correctCount    Int?     @map("correct_count")
  wrongCount      Int?     @map("wrong_count")
  unansweredCount Int?     @map("unanswered_count")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id                String    @id @default(uuid()) @db.Uuid
  attemptId         String    @map("attempt_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  /// string[] of selected QuestionOption ids (supports MULTIPLE_CHOICE).
  selectedOptionIds Json      @map("selected_option_ids")
  isCorrect         Boolean?  @map("is_correct")
  marksAwarded      Decimal?  @map("marks_awarded") @db.Decimal(6, 2)
  answeredAt        DateTime? @map("answered_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_attempt_answers")
}

// ---------------------------------------------------------------------------
// Creative Assignment Engine (Sprint 5, CREATIVE-10 §2-4/§6, ADR-0015). File
// upload is presigned-URL-based (no bytes through the API); malware scanning
// is quarantine-by-default (a file is never downloadable until CLEAN).
// Positional image annotations (CREATIVE-10 §7) are deferred — not modeled.
// ---------------------------------------------------------------------------

/// Admin-authored preset copied onto a new Assignment at creation time — not
/// a live relation (ADR-0015): editing a template never changes assignments
/// already created from it.
model AssignmentTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  brief       String
  /// { allowedMimeTypes: string[], maxFileSizeMb: number, maxFiles: number }
  fileRules   Json      @map("file_rules")
  marksTotal  Decimal   @map("marks_total") @db.Decimal(6, 2)
  /// [{ title: string, description?: string, maxMarks: number }] skeleton.
  rubric      Json
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("assignment_templates")
}

model Assignment {
  id          String        @id @default(uuid()) @db.Uuid
  subjectId   String?       @map("subject_id") @db.Uuid
  title       String
  slug        String        @unique
  brief       String
  /// { allowedMimeTypes: string[], maxFileSizeMb: number, maxFiles: number }
  fileRules   Json          @map("file_rules")
  marksTotal  Decimal       @map("marks_total") @db.Decimal(6, 2)
  deadline    DateTime?
  status      ContentStatus @default(DRAFT)
  position    Int           @default(0)
  publishedAt DateTime?     @map("published_at")
  createdById String?       @map("created_by_id") @db.Uuid
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  subject        Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  criteria       RubricCriterion[]
  submissions    AssignmentSubmission[]
  relatedThreads Thread[]               @relation("ThreadsByAssignment")

  @@index([subjectId])
  @@index([status])
  @@map("assignments")
}

model RubricCriterion {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  title        String
  description  String?
  maxMarks     Decimal  @map("max_marks") @db.Decimal(6, 2)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores     RubricScore[]

  @@index([assignmentId])
  @@map("rubric_criteria")
}

/// A student's submission. Each resubmission after REVISION_REQUESTED is a
/// new row with an incremented version (ADR-0015) — "Student Assignment
/// History" is simply every row for (assignmentId, studentId), newest first.
model AssignmentSubmission {
  id           String                     @id @default(uuid()) @db.Uuid
  assignmentId String                     @map("assignment_id") @db.Uuid
  studentId    String                     @map("student_id") @db.Uuid
  version      Int                        @default(1)
  status       AssignmentSubmissionStatus @default(DRAFT)
  notes        String?
  reviewerId   String?                    @map("reviewer_id") @db.Uuid
  submittedAt  DateTime?                  @map("submitted_at")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation("SubmissionsByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer   User?               @relation("SubmissionsByReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  files      SubmissionFile[]
  comments   AssignmentComment[]
  review     AssignmentReview?

  @@unique([assignmentId, studentId, version])
  @@index([assignmentId, studentId])
  @@index([studentId])
  @@index([reviewerId])
  @@index([status])
  @@map("assignment_submissions")
}

model SubmissionFile {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  fileName     String         @map("file_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  storageKey   String         @unique @map("storage_key")
  scanStatus   FileScanStatus @default(PENDING) @map("scan_status")
  uploadedAt   DateTime       @default(now()) @map("uploaded_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

/// A reviewer's rubric evaluation of one submission. DRAFT lets a reviewer
/// save partial scores without exposing them; publishing flips the parent
/// submission's status to `decision` (ADR-0015).
model AssignmentReview {
  id             String          @id @default(uuid()) @db.Uuid
  submissionId   String          @unique @map("submission_id") @db.Uuid
  reviewerId     String          @map("reviewer_id") @db.Uuid
  status         ReviewStatus    @default(DRAFT)
  overallComment String?         @map("overall_comment")
  decision       ReviewDecision?
  obtainedMarks  Decimal?        @map("obtained_marks") @db.Decimal(6, 2)
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                 @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  scores     RubricScore[]

  @@index([reviewerId])
  @@map("assignment_reviews")
}

model RubricScore {
  id           String  @id @default(uuid()) @db.Uuid
  reviewId     String  @map("review_id") @db.Uuid
  criterionId  String  @map("criterion_id") @db.Uuid
  marksAwarded Decimal @map("marks_awarded") @db.Decimal(6, 2)
  comment      String?

  review    AssignmentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criterionId])
  @@map("rubric_scores")
}

/// Freeform, submission-scoped notes — distinct from structured rubric
/// feedback (ADR-0015). Visible to the student, the assigned reviewer, and admins.
model AssignmentComment {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assignment_comments")
}

/// Thin extension of a MENTOR-role User (ADR-0016) — name/email/phone/status
/// stay on User; this only holds what doesn't belong on the core identity
/// model. Workload (assigned-student count vs. maxStudents) is computed from
/// MentorAssignment, not stored here.
model MentorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  bio            String?
  specialization String?
  maxStudents    Int      @default(10) @map("max_students")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

/// History-preserving mentor↔student relationship (ADR-0016) — reassigning a
/// student sets unassignedAt on the current active row (unassignedAt IS NULL)
/// and inserts a new one; rows are never edited or deleted. "At most one
/// active mentor per student" is enforced in MentorAssignmentService, not a
/// DB constraint (mirrors D-07's raw-SQL-is-an-exception stance).
model MentorAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  mentorId     String    @map("mentor_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  student    User @relation("MentorAssignmentsByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor     User @relation("MentorAssignmentsByMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  assignedBy User @relation("MentorAssignmentsByAdmin", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([studentId, unassignedAt])
  @@index([mentorId, unassignedAt])
  @@map("mentor_assignments")
}

/// Private mentor note about a student — never visible to the student or a
/// guardian (ADR-0016).
model MentorNote {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student User @relation("MentorNotesByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("MentorNotesByMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("mentor_notes")
}

/// A task a mentor assigns to a student, with a due date (ADR-0016).
model MentorTask {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  mentorId    String           @map("mentor_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime?        @map("due_date")
  status      MentorTaskStatus @default(PENDING)
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  student User @relation("MentorTasksByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("MentorTasksByMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mentorId, status])
  @@map("mentor_tasks")
}

/// Feedback a mentor shares with a student — distinct from a MentorNote
/// (private-forever) in that feedback is the thing a mentor explicitly
/// shares (ADR-0016).
model MentorFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation("MentorFeedbackByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("MentorFeedbackByMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("mentor_feedback")
}

/// A logged 1:1 mentor-student meeting (manually recorded, no calendar
/// integration — ADR-0016).
model MentorMeeting {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  mentorId        String   @map("mentor_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at")
  durationMinutes Int?     @map("duration_minutes")
  summary         String?
  createdAt       DateTime @default(now()) @map("created_at")

  student User @relation("MentorMeetingsByStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("MentorMeetingsByMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("mentor_meetings")
}

// ---------------------------------------------------------------------------
// Community & Discussion Module (Sprint 7, ADR-0017): forums, doubt
// resolution (Thread.type = QUESTION), comments/likes/bookmarks/follows, a
// reputation foundation, moderation, and attachments. "Topics"/"Comments" in
// the sprint scope map onto Thread/Reply rather than separate models — see
// ADR-0017 for the full reasoning.
// ---------------------------------------------------------------------------

/// Thin extension of a User for community participation — mirrors
/// MentorProfile's shape. reputationPoints is a denormalized running total
/// backed by the append-only ReputationEvent ledger below.
model CommunityProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  reputationPoints Int      @default(0) @map("reputation_points")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_profiles")
}

/// Append-only reputation ledger — every point change is recorded here;
/// CommunityProfile.reputationPoints is the denormalized sum.
model ReputationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reputation_events")
}

/// Top-level forum grouping (e.g. "General Discussion", "Design Help"),
/// admin-managed.
model ForumCategory {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  boards    ForumBoard[]

  @@map("forum_categories")
}

/// A board within a category (e.g. "Fashion Design"), admin-managed.
model ForumBoard {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  title       String
  slug        String
  description String?
  position    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category  ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  threads   Thread[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("forum_boards")
}

/// A discussion thread OR a doubt-resolution question (ADR-0017 — the same
/// model serves both via `type`). isSolved/related* fields only apply to
/// QUESTION-type threads. status is the linear OPEN/CLOSED dimension;
/// isPinned/isLocked/isHidden are independent toggles a thread can hold
/// simultaneously (a pinned+locked+closed announcement is a normal state).
model Thread {
  id                  String       @id @default(uuid()) @db.Uuid
  boardId             String       @map("board_id") @db.Uuid
  authorId            String       @map("author_id") @db.Uuid
  type                ThreadType   @default(DISCUSSION)
  title               String
  body                String
  status              ThreadStatus @default(OPEN)
  isPinned            Boolean      @default(false) @map("is_pinned")
  isLocked            Boolean      @default(false) @map("is_locked")
  isHidden            Boolean      @default(false) @map("is_hidden")
  hiddenReason        String?      @map("hidden_reason")
  isSolved            Boolean      @default(false) @map("is_solved")
  viewCount           Int          @default(0) @map("view_count")
  relatedCourseId     String?      @map("related_course_id") @db.Uuid
  relatedLessonId     String?      @map("related_lesson_id") @db.Uuid
  relatedQuizId       String?      @map("related_quiz_id") @db.Uuid
  relatedAssignmentId String?      @map("related_assignment_id") @db.Uuid
  moderatedById       String?      @map("moderated_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")

  board             ForumBoard            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author            User                  @relation("ThreadsByAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy       User?                 @relation("ThreadsByModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  relatedCourse     Course?               @relation("ThreadsByCourse", fields: [relatedCourseId], references: [id], onDelete: SetNull)
  relatedLesson     Lesson?               @relation("ThreadsByLesson", fields: [relatedLessonId], references: [id], onDelete: SetNull)
  relatedQuiz       Quiz?                 @relation("ThreadsByQuiz", fields: [relatedQuizId], references: [id], onDelete: SetNull)
  relatedAssignment Assignment?           @relation("ThreadsByAssignment", fields: [relatedAssignmentId], references: [id], onDelete: SetNull)
  replies           Reply[]
  follows           ThreadFollow[]
  bookmarks         CommunityBookmark[]
  attachments       CommunityAttachment[] @relation("AttachmentsByThread")

  @@index([boardId, status])
  @@index([authorId])
  @@index([type])
  @@map("threads")
}

/// A reply to a thread — also serves as a Doubt Resolution "answer" when
/// isAcceptedAnswer is set. Nested via parentReplyId (self-relation).
model Reply {
  id               String    @id @default(uuid()) @db.Uuid
  threadId         String    @map("thread_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  parentReplyId    String?   @map("parent_reply_id") @db.Uuid
  body             String
  isAcceptedAnswer Boolean   @default(false) @map("is_accepted_answer")
  isHidden         Boolean   @default(false) @map("is_hidden")
  hiddenReason     String?   @map("hidden_reason")
  moderatedById    String?   @map("moderated_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  thread      Thread                @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                  @relation("RepliesByAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy User?                 @relation("RepliesByModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent      Reply?                @relation("NestedReplies", fields: [parentReplyId], references: [id], onDelete: Cascade)
  children    Reply[]               @relation("NestedReplies")
  attachments CommunityAttachment[] @relation("AttachmentsByReply")

  @@index([threadId])
  @@index([parentReplyId])
  @@index([authorId])
  @@map("replies")
}

/// A like on a thread or reply — targetType/targetId is a polymorphic-lite
/// pattern (no DB-level FK, since a single column can't reference two
/// different tables); application code validates the target exists.
model CommunityLike {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  targetType CommunityTargetType @map("target_type")
  targetId   String              @map("target_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("community_likes")
}

/// Bookmarking a thread for later — threads only (not replies), matching
/// typical "save this discussion" UX.
model CommunityBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("community_bookmarks")
}

/// Following a thread — a foundation for a future notification sprint; this
/// sprint only records who follows what.
model ThreadFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("thread_follows")
}

/// A report queued for moderator review — targetType/targetId mirror
/// CommunityLike's polymorphic-lite pattern.
model CommunityReport {
  id           String                @id @default(uuid()) @db.Uuid
  reporterId   String                @map("reporter_id") @db.Uuid
  targetType   CommunityTargetType   @map("target_type")
  targetId     String                @map("target_id") @db.Uuid
  reason       String
  status       CommunityReportStatus @default(PENDING)
  reviewedById String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?             @map("reviewed_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  reporter   User  @relation("ReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportsByReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
  @@map("community_reports")
}

/// Image/document attachment on a thread or reply — reuses the existing
/// FileScanStatus enum from Sprint 5's assignment uploads; scanned by a
/// second, dedicated BullMQ queue+processor since Sprint 5's processor is
/// compile-time bound to AssignmentSubmission's SubmissionFile (ADR-0017).
model CommunityAttachment {
  id         String         @id @default(uuid()) @db.Uuid
  threadId   String?        @map("thread_id") @db.Uuid
  replyId    String?        @map("reply_id") @db.Uuid
  uploaderId String         @map("uploader_id") @db.Uuid
  storageKey String         @map("storage_key")
  fileName   String         @map("file_name")
  mimeType   String         @map("mime_type")
  sizeBytes  Int            @map("size_bytes")
  scanStatus FileScanStatus @default(PENDING) @map("scan_status")
  uploadedAt DateTime       @default(now()) @map("uploaded_at")

  thread   Thread? @relation("AttachmentsByThread", fields: [threadId], references: [id], onDelete: Cascade)
  reply    Reply?  @relation("AttachmentsByReply", fields: [replyId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([replyId])
  @@map("community_attachments")
}

// ---------------------------------------------------------------------------
// Commerce, Enrollment & Payments (Sprint 8, ADR-0018): a single current-
// access-state Enrollment per (user, course), commerce (coupons/orders/
// invoices/a refund-workflow foundation), and gateway-agnostic payments
// (webhook-verified — a client callback never grants an entitlement).
// ---------------------------------------------------------------------------

/// The current access-control record for (user, course) — ADR-0018. Renewed
/// in place (new expiresAt, status back to ACTIVE), never re-inserted; Order
/// is the historical purchase record.
model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  orderId    String?          @unique @map("order_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  source     EnrollmentSource @default(FREE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  expiresAt  DateTime?        @map("expires_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

/// Applies to a single order at checkout time (ADR-0018 — no cart/bundle
/// model yet). redemptionCount only increments once the order reaches PAID.
model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique
  discountType    CouponDiscountType @map("discount_type")
  discountValue   Decimal            @map("discount_value") @db.Decimal(10, 2)
  maxRedemptions  Int?               @map("max_redemptions")
  redemptionCount Int                @default(0) @map("redemption_count")
  validFrom       DateTime?          @map("valid_from")
  validUntil      DateTime?          @map("valid_until")
  isActive        Boolean            @default(true) @map("is_active")
  createdById     String?            @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  orders    Order[]

  @@map("coupons")
}

/// One row per purchase attempt — a single course per order (ADR-0018, no
/// line-items model yet). The historical/audit trail Enrollment does not
/// preserve on its own.
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  courseId       String      @map("course_id") @db.Uuid
  couponId       String?     @map("coupon_id") @db.Uuid
  status         OrderStatus @default(PENDING)
  subtotalAmount Decimal     @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency       String      @default("INR")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments   Payment[]
  invoice    Invoice?
  enrollment Enrollment?
  refunds    Refund[]

  @@index([userId])
  @@index([status])
  @@index([courseId])
  @@map("orders")
}

/// A gateway payment attempt for an Order (ADR-0018) — only a verified
/// webhook (never a client callback) moves this to CAPTURED and the parent
/// Order to PAID. Idempotent by gatewayPaymentId.
model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayOrderId   String         @map("gateway_order_id")
  gatewayPaymentId String?        @unique @map("gateway_payment_id")
  status           PaymentStatus  @default(CREATED)
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  verifiedAt       DateTime?      @map("verified_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  issuedAt      DateTime @default(now()) @map("issued_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/// A request/review state machine only — actual gateway-side refund
/// settlement is deferred (TD-037, ADR-0018). Approving revokes the
/// associated Enrollment and marks the Order REFUNDED/PARTIALLY_REFUNDED.
model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  reviewedById  String?      @map("reviewed_by_id") @db.Uuid
  status        RefundStatus @default(REQUESTED)
  amount        Decimal      @db.Decimal(10, 2)
  reason        String
  requestedAt   DateTime     @default(now()) @map("requested_at")
  reviewedAt    DateTime?    @map("reviewed_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RefundsByRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("RefundsByReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

/// Reusable, per-(event, channel) message content with `{{placeholder}}`
/// variables (COMM-MERGED §4, ADR-0019). `bodyTemplate` is plain text with
/// Mustache-style placeholders; channels that support rich content (Email)
/// may additionally use `subject`.
model NotificationTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  eventType    String              @map("event_type")
  channel      NotificationChannel
  subject      String?
  bodyTemplate String              @map("body_template")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([eventType, channel])
  @@map("notification_templates")
}

/// One row per user (COMM-MERGED §5, ADR-0019) — channel opt-in/out, mute by
/// category, a single daily Do-Not-Disturb window (stored as minute-of-day,
/// interpreted in `timezone`), digest cadence, language and timezone.
/// Transactional notifications (password reset, email verification) bypass
/// all suppression here — see ADR-0019 §5.
model NotificationPreference {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @unique @map("user_id") @db.Uuid
  emailEnabled    Boolean                @default(true) @map("email_enabled")
  smsEnabled      Boolean                @default(true) @map("sms_enabled")
  whatsappEnabled Boolean                @default(true) @map("whatsapp_enabled")
  webPushEnabled  Boolean                @default(true) @map("web_push_enabled")
  inAppEnabled    Boolean                @default(true) @map("in_app_enabled")
  mutedCategories String[]               @default([]) @map("muted_categories")
  dndStartMinute  Int?                   @map("dnd_start_minute")
  dndEndMinute    Int?                   @map("dnd_end_minute")
  digestMode      NotificationDigestMode @default(INSTANT) @map("digest_mode")
  language        String                 @default("en")
  timezone        String                 @default("UTC")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// One row per (user, event) — powers the Notification Center and
/// read/unread (ADR-0019 §8). Distinct from NotificationDelivery, which
/// tracks per-channel delivery state; a single Notification can fan out to
/// several NotificationDelivery rows (e.g. Email + In-App + Web Push).
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  eventType       String    @map("event_type")
  category        String
  title           String
  body            String
  data            Json?
  isTransactional Boolean   @default(false) @map("is_transactional")
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// One row per (notification, channel) attempt — the COMM-MERGED §7 delivery
/// state machine lives here. `fallbackFromId` links a fallback-channel
/// delivery (e.g. SMS) back to the original delivery it escalated from (e.g.
/// WhatsApp) after exhausted retries (ADR-0019 §7).
model NotificationDelivery {
  id                  String                     @id @default(uuid()) @db.Uuid
  notificationId      String                     @map("notification_id") @db.Uuid
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(QUEUED)
  attempts            Int                        @default(0)
  lastError           String?                    @map("last_error")
  providerMessageId   String?                    @map("provider_message_id")
  fallbackFromId      String?                    @map("fallback_from_id") @db.Uuid
  suppressedReason    String?                    @map("suppressed_reason")
  // Snapshotted at delivery-creation time (WEB_PUSH only) rather than a live FK
  // to WebPushSubscription — a subscription can expire/be removed by the time
  // the queued job runs, and the delivery record should still show what was
  // attempted.
  webPushSubscription Json?                      @map("web_push_subscription")
  queuedAt            DateTime                   @default(now()) @map("queued_at")
  sentAt              DateTime?                  @map("sent_at")
  deliveredAt         DateTime?                  @map("delivered_at")
  openedAt            DateTime?                  @map("opened_at")
  clickedAt           DateTime?                  @map("clicked_at")
  acknowledgedAt      DateTime?                  @map("acknowledged_at")
  failedAt            DateTime?                  @map("failed_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([providerMessageId])
  @@index([channel, status])
  @@map("notification_deliveries")
}

/// A browser's Web Push subscription (standard Web Push API, VAPID —
/// ADR-0019 §6). One user may have several (one per browser/device).
model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

/// Analytics & Reporting (Sprint 10, ADR-0020 §5) — the scheduled-reports
/// foundation. A repeatable BullMQ job (`scheduled-reports` queue) fires on
/// `cadence`, recomputes `reportType`'s query with `filters`, and enqueues a
/// summary Notification to `createdBy` — it does not attach the CSV/PDF file
/// (TD-042); an admin opens the live dashboard or on-demand export for that.
model ScheduledReport {
  id          String         @id @default(uuid()) @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  name        String
  reportType  ReportType     @map("report_type")
  format      ReportFormat   @default(CSV)
  cadence     ReportCadence
  /// Report-type-specific filter params (date range, courseId, etc.) — shape
  /// validated per reportType in ReportBuilderService, not at the DB layer.
  filters     Json?
  isActive    Boolean        @default(true) @map("is_active")
  lastRunAt   DateTime?      @map("last_run_at")
  nextRunAt   DateTime?      @map("next_run_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([isActive, nextRunAt])
  @@map("scheduled_reports")
}

/// Per-recommendation-type kill switch (Sprint 11, ADR-0021 §4) — lets an
/// admin disable a specific recommendation surface platform-wide without a
/// deploy. Absence of a row for a type means enabled (fail-open default).
model RecommendationFeatureFlag {
  id          String             @id @default(uuid()) @db.Uuid
  type        RecommendationType @unique
  isEnabled   Boolean            @default(true) @map("is_enabled")
  updatedById String?            @map("updated_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("recommendation_feature_flags")
}

/// Media Library (Sprint 12, ADR-0022 §5). Uploaded via the same presigned
/// StoragePort flow as assignment submissions (ADR-0015); scanStatus defaults
/// to PENDING (quarantine-by-default) until the shared malware scanner
/// primitive marks it CLEAN via CmsAssetScanQueueService.
model CmsAsset {
  id           String         @id @default(uuid()) @db.Uuid
  fileName     String         @map("file_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  storageKey   String         @unique @map("storage_key")
  scanStatus   FileScanStatus @default(PENDING) @map("scan_status")
  altText      String?        @map("alt_text")
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  usages     CmsAssetUsage[]
  banners    CmsBanner[]

  @@map("cms_assets")
}

/// Tracks which content items reference a given asset — "Asset Reuse"
/// (ADR-0022 §5) without scanning content bodies for asset references.
model CmsAssetUsage {
  id          String         @id @default(uuid()) @db.Uuid
  assetId     String         @map("asset_id") @db.Uuid
  contentType CmsContentType @map("content_type")
  contentId   String         @map("content_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  asset CmsAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, contentType, contentId])
  @@index([contentType, contentId])
  @@map("cms_asset_usages")
}

/// Landing Pages and Static Pages (Sprint 12, ADR-0022 §2) — one model, a
/// `pageType` discriminator, since both are identically shaped.
model CmsPage {
  id                  String            @id @default(uuid()) @db.Uuid
  pageType            CmsPageType       @map("page_type")
  slug                String            @unique
  title               String
  body                String
  seoTitle            String?           @map("seo_title")
  seoDescription      String?           @map("seo_description")
  status              CmsWorkflowStatus @default(DRAFT)
  version             Int               @default(1)
  scheduledPublishAt  DateTime?         @map("scheduled_publish_at")
  scheduledUnpublishAt DateTime?        @map("scheduled_unpublish_at")
  publishedAt         DateTime?         @map("published_at")
  createdById         String            @map("created_by_id") @db.Uuid
  updatedById         String?           @map("updated_by_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  createdBy User  @relation("CmsPageCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy User? @relation("CmsPageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([pageType, status])
  @@map("cms_pages")
}

model CmsFaqItem {
  id                  String            @id @default(uuid()) @db.Uuid
  question            String
  answer              String
  category            String?
  position            Int               @default(0)
  status              CmsWorkflowStatus @default(DRAFT)
  version             Int               @default(1)
  scheduledPublishAt  DateTime?         @map("scheduled_publish_at")
  scheduledUnpublishAt DateTime?        @map("scheduled_unpublish_at")
  publishedAt         DateTime?         @map("published_at")
  createdById         String            @map("created_by_id") @db.Uuid
  updatedById         String?           @map("updated_by_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  createdBy User  @relation("CmsFaqItemCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy User? @relation("CmsFaqItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, position])
  @@map("cms_faq_items")
}

model CmsAnnouncement {
  id                  String            @id @default(uuid()) @db.Uuid
  title               String
  body                String
  status              CmsWorkflowStatus @default(DRAFT)
  version             Int               @default(1)
  scheduledPublishAt  DateTime?         @map("scheduled_publish_at")
  scheduledUnpublishAt DateTime?        @map("scheduled_unpublish_at")
  publishedAt         DateTime?         @map("published_at")
  createdById         String            @map("created_by_id") @db.Uuid
  updatedById         String?           @map("updated_by_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  createdBy User  @relation("CmsAnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy User? @relation("CmsAnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("cms_announcements")
}

model CmsBanner {
  id                  String            @id @default(uuid()) @db.Uuid
  title                String
  imageAssetId         String?           @map("image_asset_id") @db.Uuid
  linkUrl              String?           @map("link_url")
  placement            String
  position             Int               @default(0)
  status               CmsWorkflowStatus @default(DRAFT)
  version              Int               @default(1)
  scheduledPublishAt   DateTime?         @map("scheduled_publish_at")
  scheduledUnpublishAt DateTime?         @map("scheduled_unpublish_at")
  publishedAt          DateTime?         @map("published_at")
  createdById          String            @map("created_by_id") @db.Uuid
  updatedById          String?           @map("updated_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  imageAsset CmsAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdBy  User      @relation("CmsBannerCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy  User?     @relation("CmsBannerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([placement, status, position])
  @@map("cms_banners")
}

/// Generic version history for every CMS content type (Sprint 12, ADR-0022
/// §3) — one table backs Content Version History/Compare/Restore for
/// Pages/FAQ/Announcements/Banners alike, keyed by (contentType, contentId).
model CmsContentVersion {
  id            String            @id @default(uuid()) @db.Uuid
  contentType   CmsContentType    @map("content_type")
  contentId     String            @map("content_id") @db.Uuid
  versionNumber Int               @map("version_number")
  snapshot      Json
  status        CmsWorkflowStatus
  changeNote    String?           @map("change_note")
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([contentType, contentId, versionNumber])
  @@index([contentType, contentId])
  @@map("cms_content_versions")
}
